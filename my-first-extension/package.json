{
  "name": "ag-switch",
  "displayName": "AG Switch",
  "description": "Antigravity model & account switcher for VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ag-switch.showStatus",
        "title": "AG Switch: Show Status"
      }
    ],
    "configuration": {
      "title": "AG Switch",
      "properties": {
        "ag-switch.port": {
          "type": "number",
          "default": 23816,
          "description": "Port for the AG Switch local HTTP server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "sql.js": "^1.14.0"
  }
}
